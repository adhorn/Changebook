# Backend configuration
# Copy this file to backend/.env and adjust as needed

# Database — defaults to SQLite for local development
# For Postgres: postgresql://changebook:changebook@localhost:5432/changebook
CHANGEBOOK_DATABASE_URL=sqlite:///./changebook_dev.db

# Debug mode — enables SQL logging
CHANGEBOOK_DEBUG=false

# CORS origins — comma-separated list in JSON format
CHANGEBOOK_CORS_ORIGINS=["http://localhost:3000"]

# Frontend configuration (set in frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
